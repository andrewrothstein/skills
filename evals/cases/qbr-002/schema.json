{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "company",
    "quarter",
    "year",
    "presenter",
    "metrics",
    "risks"
  ],
  "properties": {
    "company": {
      "type": "string"
    },
    "quarter": {
      "type": "string",
      "enum": [
        "Q1",
        "Q2",
        "Q3",
        "Q4"
      ]
    },
    "year": {
      "type": "integer"
    },
    "presenter": {
      "type": "string"
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "value",
          "yoy_change_pct"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "string",
            "description": "as shown on the slide, e.g. '$4.2M' or '38%'"
          },
          "yoy_change_pct": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
