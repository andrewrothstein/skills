{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meeting_title",
    "date",
    "attendees",
    "decisions",
    "action_items"
  ],
  "properties": {
    "meeting_title": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "attendees": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "action_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "owner",
          "task",
          "due_date"
        ],
        "properties": {
          "owner": {
            "type": "string"
          },
          "task": {
            "type": "string"
          },
          "due_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          }
        }
      }
    }
  }
}
