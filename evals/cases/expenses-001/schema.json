{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_month",
    "department",
    "currency",
    "expenses",
    "total_amount"
  ],
  "properties": {
    "report_month": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}$"
    },
    "department": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "expenses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "employee",
          "category",
          "amount"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "employee": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          }
        }
      }
    },
    "total_amount": {
      "type": "number"
    }
  }
}
